# --- Obligatorii ---
POLYMARKET_PRIVATE_KEY=your_private_key_here
FUNDER_ADDRESS=your_wallet_address_here

# --- Conexiune Polymarket ---
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
# 0=EOA, 1=POLY_PROXY (Magic), 2=POLY_GNOSIS_SAFE, 3=POLY_1271/EIP-1271 (proxy).
# Notă: cu chei API explicite, ordinele folosesc întotdeauna 3 (vezi clob_client.py).
SIGNATURE_TYPE=3
# Recomandat: RPC autentificat (Alchemy/Infura) în loc de RPC public
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Chei API pre-generate din Polymarket UI (opționale) ---
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Surse de date ---
X_API_BEARER_TOKEN=your_x_api_token_here
NEWS_API_KEY=your_news_api_key_here
GROQ_API_KEY=your_groq_key_here

# --- Risc & siguranță ---
LOG_LEVEL=INFO
# Număr maxim de poziții deschise simultan (0 = fără limită)
MAX_ACTIVE_POSITIONS=5
# Balanță cunoscută (pUSD) când /balance-allowance returnează 0 pe conturi proxy.
# ATENȚIE: lasă 0 dacă nu e necesar — altfel botul presupune fonduri inexistente.
OVERRIDE_BALANCE=0
# Plafon USDC aprobat pentru CLOB Exchange, în USD (0 = aprobare NELIMITATĂ —
# recomandat să setezi o valoare, ex. 100, pentru a limita expunerea on-chain)
USDC_APPROVAL_USD=0
# Plafon gas pe Polygon în gwei; tranzacțiile se amână peste acest prag (0 = dezactivat)
MAX_GAS_PRICE_GWEI=500
# Take-profit / stop-loss ca fracție din prețul mediu de intrare (0 = dezactivat).
# Default: TP=0 (câștigătorii se țin până la rezoluție, unde e tot edge-ul),
# SL=0.30 (-30% ≈ prețul scade sub ~0.5 de la o intrare tipică → teza invalidată).
TAKE_PROFIT_PCT=0
STOP_LOSS_PCT=0.30
# Toleranță slippage la BUY față de best ask live (0.05 = 5%; 0 = dezactivat)
SLIPPAGE_TOLERANCE=0.05

# --- Scanare piețe ---
# Câte piețe active se scanează per buclă (paginat). >30 ca să prindă și
# meciurile individuale, îngropate sub piețele mari de tip outright.
MARKET_SCAN_LIMIT=200
# Sortare Gamma (gol = ordinea implicită). Ex: volumeNum (lichide întâi) sau
# startDate (cele mai noi — utile pentru meciurile create azi). O valoare respinsă
# de API e reluată automat fără sortare.
GAMMA_ORDER=
GAMMA_ASCENDING=false
# Volum minim ($) ca o piață să fie analizată. Coboară-l dacă meciurile de azi
# (volum mic la creare) sunt filtrate — ex. 1000.
MIN_VOLUME_USD=10000
# Fereastra de probabilitate YES, UNICĂ pentru toate tipurile (meci/outright/general).
# [0.45, 0.95] ține botul concentrat pe meciurile competitive (probabilități medii-mari)
# și ignoră „zgomotul" de probabilitate foarte mică; decizia reală rămâne la LLM + pragul
# de confidence. Lărgește-o (ex. 0.01) dacă vrei să trimiți mai multe piețe spre analiză.
PROBABILITY_MIN=0.45
PROBABILITY_MAX=0.95
# Deep-scan opțional pe tag-uri Gamma NUMERICE (CSV), ex. fotbal / FIFA World Cup.
# Gol = dezactivat. Găsește tag_id-ul real inspectând un URL Gamma de categorie
# (ex. https://gamma-api.polymarket.com/markets?tag_id=<id>) înainte de a-l seta.
GAMMA_TAG_IDS=
# Cale pentru istoricul piețelor analizate. Pe Railway, /app e efemer și root-only:
# pointează spre un volum montat scriibil (ex. /data/history.json) pentru persistență.
HISTORY_FILE=

# --- Notificări Discord ---
# Webhook pentru alerte buy/sell și raportul periodic de portofoliu (gol = dezactivat).
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Interval raport portofoliu pe Discord, în ore (0 = dezactivat raportul). La fiecare
# interval se trimit 2 mesaje grupate: „💵 Status Financiar" + „📦 Poziții Active".
# Lista piețelor scanate NU se mai trimite pe Discord — rămâne strict în consolă/loguri.
# Ex. 0.5 = la fiecare 30 de minute.
PNL_REPORT_INTERVAL_HOURS=1
