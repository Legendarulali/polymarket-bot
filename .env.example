# --- Obligatorii ---
POLYMARKET_PRIVATE_KEY=your_private_key_here
FUNDER_ADDRESS=your_wallet_address_here

# --- Conexiune Polymarket ---
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
# 0=EOA, 1=POLY_PROXY (Magic), 2=POLY_GNOSIS_SAFE, 3=POLY_1271/EIP-1271 (proxy).
# Notă: cu chei API explicite, ordinele folosesc întotdeauna 3 (vezi clob_client.py).
SIGNATURE_TYPE=3
# Recomandat: RPC autentificat (Alchemy/Infura) în loc de RPC public
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Chei API pre-generate din Polymarket UI (opționale) ---
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# --- Surse de date ---
X_API_BEARER_TOKEN=your_x_api_token_here
NEWS_API_KEY=your_news_api_key_here
GROQ_API_KEY=your_groq_key_here

# --- Risc & siguranță ---
LOG_LEVEL=INFO
# Mod SIMULARE (stress test). IMPLICIT false. Pe true: botul scanează și trimite
# loturile către Groq (ca să testăm rate-limit-urile) trecând peste gate-urile de
# balanță (1.05 pUSD) și de expunere, dar NU plasează NICIUN ordin real (BUY-ul e
# interceptat la intrarea în _execute_trade; TP/SL sunt sărite) și NU scrie în
# history.json (ca să nu polueze cooldown-ul real). Folosește-l DOAR pentru teste.
DRY_RUN=false
# Mod TEST NOTIFICĂRI (STEP 3). IMPLICIT false. Două regimuri:
#  - cu DRY_RUN=false (LIVE): după FIECARE buy real reușit, botul așteaptă 1s și vinde
#    imediat exact câte share-uri a cumpărat (SELL real la best bid) -> ambele webhook-uri
#    (BUY+SELL) cu ordine REALE. ATENȚIE: bani reali.
#  - cu DRY_RUN=true (SIMULARE, fără fonduri): NU se plasează NICIUN ordin — botul simulează
#    un ciclu BUY->1s->SELL și declanșează ambele webhook-uri cu date nominale (~$5). E modul
#    recomandat ca să testezi notificările FĂRĂ balanță (gate-ul de balanță / standby-ul de
#    15 min e deja sărit în DRY_RUN). În plus, fereastra de probabilitate se lărgește la
#    (0.01–0.99) ca botul să găsească ușor o piață care declanșează testul.
# Suprascrie orice holding/TP/SL. Lasă false în operare normală.
NOTIFICATION_TEST_MODE=false
# Număr maxim de poziții deschise simultan (0 = fără limită)
MAX_ACTIVE_POSITIONS=5
# Balanță cunoscută (pUSD) când /balance-allowance returnează 0 pe conturi proxy.
# ATENȚIE: lasă 0 dacă nu e necesar — altfel botul presupune fonduri inexistente.
OVERRIDE_BALANCE=0
# Plafon USDC aprobat pentru CLOB Exchange, în USD (0 = aprobare NELIMITATĂ —
# recomandat să setezi o valoare, ex. 100, pentru a limita expunerea on-chain)
USDC_APPROVAL_USD=0
# Plafon gas pe Polygon în gwei; tranzacțiile se amână peste acest prag (0 = dezactivat)
MAX_GAS_PRICE_GWEI=500
# Take-profit / stop-loss ca fracție din prețul mediu de intrare (0 = dezactivat).
# Default: TP=0 (câștigătorii se țin până la rezoluție, unde e tot edge-ul),
# SL=0.30 (-30% ≈ prețul scade sub ~0.5 de la o intrare tipică → teza invalidată).
TAKE_PROFIT_PCT=0
STOP_LOSS_PCT=0.30
# Toleranță slippage la BUY față de best ask live (0.05 = 5%; 0 = dezactivat)
SLIPPAGE_TOLERANCE=0.05
# --- Panic Sell (STEP 4): re-evaluare pe ȘTIRI a pozițiilor DEȚINUTE ---
# IMPLICIT false (opt-in): e o lichidare REALĂ declanșată de judecata unui LLM. Când e
# true, botul re-evaluează periodic pozițiile deschise pe baza știrilor recente și, dacă
# Groq vede o dezvoltare care invalidează CATASTROFAL teza de BUY (accidentări cheie,
# răsturnări de scor, scandaluri), le LICHIDEAZĂ la best bid (SELL) — independent de cash
# (vânzarea folosește token-urile deținute, nu fonduri) și ocolind gate-ul de balanță.
PANIC_SELL_ENABLED=false
# Cât de des re-evaluăm pozițiile (minute). ≤ MAX_ACTIVE_POSITIONS apeluri Groq la fiecare
# interval → buget de tokeni minim (≠ scanarea masivă). Recomandat 15-30 (implicit 30).
POSITION_REEVAL_INTERVAL_MINUTES=30
# Pragul de confidence peste care acționăm un PANIC_SELL (conservator — nu lichidăm pe semnale slabe).
PANIC_SELL_MIN_CONFIDENCE=0.70

# --- Scanare piețe ---
# Mod universal (IMPLICIT, false): botul evaluează TOATE piețele active —
# politice, crypto, generale ȘI meciuri de fotbal (acestea pe ruta 1X2).
# Pune pe true DOAR ca să restrângi scanarea exclusiv la meciuri de fotbal
# (ignoră outright/general) — util în timpul unui turneu.
FOOTBALL_ONLY=false
# Plafon OPȚIONAL de siguranță pe câte piețe se preiau per buclă. 0 (implicit) =
# fără plafon → paginarea dinamică preia TOATE piețele active (offset += 100 până
# când Gamma întoarce o pagină goală/parțială). Setează o valoare (ex. 2000) doar
# ca să limitezi numărul de cereri pe rețele cu rate-limit agresiv.
MARKET_SCAN_LIMIT=0
# Analiză în LOTURI: câte piețe (după filtrare) trimitem la Groq într-UN singur apel.
# Reduce drastic numărul de cereri → permite modelul gpt-oss-20b fără
# a lovi rate-limit-urile (429). Implicit 12 (recomandat 10-15). Pune 1 ca să revii la
# analiza individuală (o cerere per piață), util la depanare.
BATCH_SIZE=12
# Backoff (secunde) când Groq întoarce 429 (rate-limit) la un lot: botul așteaptă atât
# înainte de a reîncerca la scanarea următoare, ca să nu ardă bugetul zilnic de tokeni.
RATE_LIMIT_BACKOFF_SECONDS=60
# Throttle (secunde) DUPĂ fiecare apel Groq (o dată per LOT). Spațiază cererile când se
# scanează sute de piețe. Acceptă fracțiuni (ex. 1.5).
INTER_ANALYSIS_DELAY_SECONDS=3
# Cadența SCANĂRII masive (minute): fetch Gamma + analiză Groq rulează cel mult o dată la
# acest interval, ca să NU lovești Gamma/Groq în fiecare minut. IMPLICIT 15 (recomandat
# 15-30). Restul buclei (monitorizare + vânzare poziții, TP/SL, Panic Sell, raport P/L)
# rămâne reactiv la LOOP_INTERVAL_SECONDS. 0 = scanează la fiecare buclă (vechiul comportament).
SCAN_INTERVAL_MINUTES=15
# Heartbeat-ul buclei (secunde). Mic (60) ca pozițiile să fie monitorizate/vândute prompt;
# scanarea masivă e throttle-ată separat prin SCAN_INTERVAL_MINUTES.
LOOP_INTERVAL_SECONDS=60
# --- Filtru STRICT anti-429 (STEP 2) ---
# Reduce câte piețe ajung la Groq. IMPLICIT activ. Păstrează piețele cu poziție deschisă,
# cele cu volum ≥ STRICT_MIN_VOLUME_USD și (dacă STRICT_KEYWORDS e setat) cele al căror
# titlu/slug conține un keyword; apoi sortează după volum desc.
# STRICT_FILTER=false revine la „scanează tot". ATENȚIE: pragul de volum poate filtra
# meciurile de azi (volum mic la creare) — coboară-l sau adaugă echipele în STRICT_KEYWORDS.
STRICT_FILTER=true
STRICT_MIN_VOLUME_USD=50000
# Plafon dur pe câte piețe ajung la analiză după filtru. IMPLICIT 0 = FĂRĂ plafon →
# se analizează TOT ce trece de filtrul de volum (~900 piețe). Anti-429 e asigurat de
# batching (BATCH_SIZE) + throttle (INTER_ANALYSIS_DELAY_SECONDS) + cadența de scanare
# (SCAN_INTERVAL_MINUTES) + cooldown-ul de 4h. Pune >0 (ex. 500) DOAR ca să re-impui un plafon.
MAX_MARKETS_PER_SCAN=0
# CSV de cuvinte-cheie de interes (gol = dezactivat). Ex: trump,bitcoin,arsenal,election.
STRICT_KEYWORDS=
# Sortare Gamma (gol = ordinea implicită). Ex: volumeNum (lichide întâi) sau
# startDate (cele mai noi — utile pentru meciurile create azi). O valoare respinsă
# de API e reluată automat fără sortare.
GAMMA_ORDER=
GAMMA_ASCENDING=false
# Volum minim ($) ca o piață să fie analizată. Coboară-l dacă meciurile de azi
# (volum mic la creare) sunt filtrate — ex. 1000.
MIN_VOLUME_USD=10000
# Fereastra de probabilitate YES, aplicată pe FIECARE rezultat 1X2 al meciului
# (prețul Polymarket al unui rezultat = probabilitatea lui YES). Se pariază doar
# pe rezultate (1/X/2) cu probabilitate în [0.45, 0.95]; dacă niciunul nu califică,
# meciul e ignorat. Notă: cota egalului (X) rar depășește 0.45, deci în practică
# pragul favorizează 1 sau 2. Lărgește fereastra (ex. PROBABILITY_MIN=0.25) dacă
# vrei să prinzi și egaluri sau outsideri.
PROBABILITY_MIN=0.45
PROBABILITY_MAX=0.95
# Deep-scan opțional pe tag-uri Gamma NUMERICE (CSV), ex. fotbal / FIFA World Cup.
# Gol = dezactivat. Găsește tag_id-ul real inspectând un URL Gamma de categorie
# (ex. https://gamma-api.polymarket.com/markets?tag_id=<id>) înainte de a-l seta.
GAMMA_TAG_IDS=
# Cale pentru istoricul piețelor analizate. Pe Railway, /app e efemer și root-only:
# pointează spre un volum montat scriibil (ex. /data/history.json) pentru persistență.
HISTORY_FILE=
# Activează coada „Wishlist" (next_in_line.json). IMPLICIT false (coada e inertă —
# funcțiile ei nu sunt apelate). Când e true, piețele aprobate de AI care NU pot fi
# deschise pentru că s-a atins MAX_ACTIVE_POSITIONS (deși balanța e suficientă, ≥1.05)
# sunt salvate și re-evaluate prioritar când se eliberează un slot. NU atinge regula
# de balanță de 1.05 care protejează API-ul.
ACTIVATE_QUEUE=false
# Cale pentru fișierul cozii „Wishlist" (folosit doar dacă ACTIVATE_QUEUE=true). La fel
# ca HISTORY_FILE, pe Railway pointează spre un volum montat (ex. /data/next_in_line.json).
QUEUE_FILE=

# --- Notificări Discord ---
# Webhook pentru alerte buy/sell și raportul periodic de portofoliu (gol = dezactivat).
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Interval raport portofoliu pe Discord, în ore (0 = dezactivat raportul). Raportul e
# ALINIAT la ceas (oră fixă xx:00, ca resetul orar de metrici Polymarket), NU la
# intervalul scurs de la pornire: cu 1 → la fix la fiecare oră; 0.5 → la xx:00 și xx:30;
# 2 → la orele pare. Dacă botul pornește la 14:45, primul raport iese la 15:00 (fără
# raport parțial instant). La fiecare graniță se trimit 2 mesaje grupate: „💵 Status
# Financiar" + „📦 Poziții Active". Lista piețelor scanate NU se trimite pe Discord —
# rămâne strict în consolă/loguri. (Pe Railway containerul rulează în UTC ⇒ xx:00 UTC.)
PNL_REPORT_INTERVAL_HOURS=1
